<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!-- SEND_SMS / CALL_PHONE imply telephony; declare it optional so the app
         remains installable on non-telephony devices (e.g. ChromeOS, tablets). -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Package visibility for implicit intents resolved at runtime
         (Android 11+ hides these without an explicit declaration). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
        </intent>
    </queries>

    <application
        android:name=".NekoGpsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NekoGps"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NekoGps.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MapsActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".NavigationActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.hud.HUDActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".TracksActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".PoiSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.bookmarks.BookmarkActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.findmycar.FindMyCarActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.sharelocation.ShareLocationActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.waypoints.WaypointActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <!-- Gamification Activities -->
        <activity
            android:name=".features.gamification.AchievementActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.gamification.LeaderboardActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.gamification.LocationChallengeActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.gamification.PhotoWaypointActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps"
            android:hardwareAccelerated="true" />

        <activity
        android:name=".features.routing.RouteOptionsActivity"
        android:exported="false"
        android:theme="@style/Theme.NekoGps" />

        <activity
        android:name=".features.routing.AlternativeRoutesActivity"
        android:exported="false"
        android:theme="@style/Theme.NekoGps" />

        <activity
        android:name=".features.routing.RoundTripActivity"
        android:exported="false"
        android:theme="@style/Theme.NekoGps" />

        <!-- Phase 4: Fuel Price, Odometer, Statistics, Route Replay -->
        <activity
            android:name=".features.stats.FuelPriceActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.stats.OdometerActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.stats.StatisticsActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <activity
            android:name=".features.stats.RouteReplayActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <!-- Phase 7: Safety & Emergency -->
        <activity
            android:name=".features.safety.SafetyActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <!-- Phase 8: Customization & UI -->
        <activity
            android:name=".features.ui.CarModeActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps" />

        <!-- Phase 10: Performance & Polish -->
        <activity
            android:name=".features.performance.PerformanceActivity"
            android:exported="false"
            android:theme="@style/Theme.NekoGps"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <service
            android:name=".service.LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
