<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1b1938"
    tools:context=".features.routing.AlternativeRoutesActivity">

    <!-- Title Bar -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Alternative Routes"
        android:textColor="#e9e5dd"
        android:textSize="22sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="#292827"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Route Options Toggle -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvRouteOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#292827"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Route Preferences"
                android:textColor="#cbb7fb"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Avoidance Toggle Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Avoid:"
                    android:textColor="#dcd7d3"
                    android:textSize="14sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAvoidTolls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tolls"
                    android:textColor="#e9e5dd" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAvoidHighways"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Highways"
                    android:textColor="#e9e5dd" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAvoidFerries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ferries"
                    android:textColor="#e9e5dd" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Routes List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoutes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/cvRouteOptions"
        app:layout_constraintBottom_toTopOf="@id/btnSelectRoute"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Select Route Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvSelectRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#cbb7fb"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnSelectRoute"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Select This Route"
            android:textColor="#1b1938"
            android:textStyle="bold"
            android:backgroundTint="#cbb7fb" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>