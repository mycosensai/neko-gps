<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1b1938"
    tools:context=".features.sharelocation.ShareLocationActivity">

    <!-- Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#292827"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#cbb7fb"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📤"
                android:textSize="24sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share Location"
                    android:textColor="#cbb7fb"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send your location to friends, nya~"
                    android:textColor="#e9e5dd"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Location Info -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvLocationInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#292827"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#cbb7fb"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cvHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvShareCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coordinates: 0.000000, 0.000000"
                android:textColor="#cbb7fb"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShareAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Address: Loading..."
                android:textColor="#e9e5dd"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvShareMapsLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://maps.google.com/"
                android:textColor="#714cb6"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:autoLink="web" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Share Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/cvLocationInfo">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="📱 Share via SMS"
            android:textSize="14sp"
            app:backgroundTint="#4CAF50"
            android:textColor="#ffffff"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="📧 Share via Email"
            android:textSize="14sp"
            app:backgroundTint="#2196F3"
            android:textColor="#ffffff"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="💬 Share via Messaging App"
            android:textSize="14sp"
            app:backgroundTint="#7C4DFF"
            android:textColor="#ffffff"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareGeneric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="📋 Share via Other Apps"
            android:textSize="14sp"
            app:backgroundTint="#cbb7fb"
            android:textColor="#1b1938"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="🗺️ Open in Google Maps"
            android:textSize="14sp"
            app:backgroundTint="#FF9800"
            android:textColor="#ffffff"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔗 Copy Link"
            android:textSize="14sp"
            app:backgroundTint="#292827"
            android:textColor="#e9e5dd"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
