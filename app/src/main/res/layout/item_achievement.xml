<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#292827"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#cbb7fb"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Achievement Icon -->
        <TextView
            android:id="@+id/ivAchievementIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#cbb7fb"
            android:background="@drawable/circle_bg_dark"
            android:layout_marginEnd="12dp" />

        <!-- Achievement Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAchievementName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Achievement Name"
                android:textColor="#cbb7fb"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAchievementDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#e9e5dd"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Status Icon -->
        <ImageView
            android:id="@+id/ivStatusIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            app:tint="#cbb7fb" />

        <!-- Unlock Date -->
        <TextView
            android:id="@+id/tvUnlockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#714cb6"
            android:textSize="10sp"
            android:layout_marginEnd="4dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>