<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#292827"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#dcd7d3"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- POI Icon -->
        <ImageView
            android:id="@+id/ivPoiIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_location"
            android:background="@drawable/circle_bg"
            android:padding="12dp"
            android:layout_marginEnd="12dp" />

        <!-- POI Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPoiName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Place Name"
                android:textColor="#cbb7fb"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPoiType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type"
                android:textColor="#dcd7d3"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvPoiDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 km away"
                android:textColor="#e9e5dd"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Add Button -->
        <Button
            android:id="@+id/btnAddToMap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#cbb7fb"
            android:text="Add"
            android:textColor="#1b1938"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
