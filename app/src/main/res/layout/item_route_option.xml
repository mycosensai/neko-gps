<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1b1938"
    tools:context=".features.routing.RouteOptionsActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/tvRouteName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Route"
        android:textColor="#e9e5dd"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="#292827"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Distance -->
    <TextView
        android:id="@+id/tvRouteDistance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Distance: --"
        android:textColor="#e9e5dd"
        android:textSize="16sp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvRouteName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ETA -->
    <TextView
        android:id="@+id/tvRouteEta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ETA: --"
        android:textColor="#e9e5dd"
        android:textSize="16sp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvRouteDistance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Preference Tag -->
    <TextView
        android:id="@+id/tvRoutePreference"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Shortest"
        android:textColor="#cbb7fb"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:background="#292827"
        app:layout_constraintTop_toBottomOf="@id/tvRouteEta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Select Button -->
    <Button
        android:id="@+id/btnSelectRoute"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Select This Route"
        android:textColor="#1b1938"
        android:textStyle="bold"
        android:backgroundTint="#cbb7fb"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
